# =============================================================================
# backend/Containerfile — PlatformInit Ops Center API
#
# Build stage: install dependencies with uv
# Runtime:     non-root uvicorn on port 8000
# =============================================================================
FROM docker.io/python:3.12-slim AS builder

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

RUN pip install --no-cache-dir uv

WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app/ ./app/
RUN uv sync --frozen --no-dev

# ---------------------------------------------------------------------------
# Runtime image
# ---------------------------------------------------------------------------
FROM docker.io/python:3.12-slim

RUN groupadd --system --gid 1001 app \
    && useradd --system --gid app --uid 1001 --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app

COPY --from=builder /build/.venv/ ./.venv/
COPY --from=builder /build/app/ ./app/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

EXPOSE 8000

USER app:app

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
